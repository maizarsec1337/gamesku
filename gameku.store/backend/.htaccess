# .htaccess backend (opsional, untuk Apache/XAMPP): teruskan /api/* ke front-controller.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lewati jika berkas atau folder asli ada (uploads, dll).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ api/index.php [QSA,L]
</IfModule>

# Jangan tampilkan isi folder.
Options -Indexes
