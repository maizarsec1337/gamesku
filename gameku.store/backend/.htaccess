# ---------------------------------------------------------------------
# .htaccess backend gameku.store (opsional, untuk Apache / XAMPP).
#
# Meneruskan semua request /api/* ke api/index.php (front-controller),
# KECUALI bila berkas/folder benar-benar ada (mis. gambar di /uploads/).
# Tidak diperlukan bila menjalankan lewat `php -S ... api/index.php`.
# ---------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lewati jika berkas atau folder asli ada (uploads, dll).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Teruskan sisanya ke front-controller, pertahankan query string.
    RewriteRule ^ api/index.php [QSA,L]
</IfModule>

# Jangan tampilkan isi folder.
Options -Indexes
