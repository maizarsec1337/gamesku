# ===================================================================
# GameKU Backend — Environment Variables (Production/Staging)
# Salin file ini menjadi .env dan isi nilai yang sesuai.
# Jangan commit file .env ke version control (lihat .gitignore).
# ===================================================================

# --- Database (akun dengan hak akses minimum) ---
GAMEKU_DB_HOST=127.0.0.1
GAMEKU_DB_PORT=3306
GAMEKU_DB_NAME=gameku_store
GAMEKU_DB_USER=gameku_app
GAMEKU_DB_PASS=ganti-dengan-password-yang-aman

# --- Aplikasi ---
GAMEKU_APP_ORIGIN=https://store.example.com
GAMEKU_APP_PORT=8000

# --- Keamanan ---
# Aktifkan cookie Secure (HTTPS) pada production. Set 1 di production, 0 di localhost.
GAMEKU_SECURE_COOKIE=1
# Mode debug: 1 untuk development (stack trace di respons), 0 untuk production.
GAMEKU_DEBUG=0
# Environment: production | staging | development
GAMEKU_ENV=production

# --- CORS (origin frontend yang diizinkan, pisahkan dengan koma) ---
# Jangan gunakan wildcard * pada production.
GAMEKU_APP_ORIGIN=https://store.example.com,https://www.store.example.com

# --- Proxy (hanya jika backend di balik reverse proxy seperti Cloudflare/Nginx) ---
# Set 1 jika backend menerima X-Forwarded-For dari proxy tepercaya.
GAMEKU_TRUST_PROXY=0

# --- Asisten AI (opsional; hanya di backend, JANGAN di frontend) ---
GAMEKU_CHAT_ENDPOINT=
GAMEKU_CHAT_KEY=
GAMEKU_CHAT_MODEL=gpt-4o-mini
