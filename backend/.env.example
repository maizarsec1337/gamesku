# Runtime URL: Supabase Supavisor transaction pooler (port 6543) for Vercel/serverless.
# For a persistent Node server, use the session pooler (port 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Schema changes only: direct database host (IPv6-capable runtime) or Supavisor session mode.
DIRECT_URL=postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_POOL_MAX=1

NODE_ENV=development
PORT=8000
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional persistent upload target. Keep credentials server-side; no VITE_ prefix.
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# For Vercel/large files: enable bucket CORS for APP_ORIGIN and PUT with Content-Type.
SESSION_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
PUBLIC_API_ORIGIN=

# Legacy database connection, needed only for an explicit transfer run.
LEGACY_DATABASE_URL=mysql://user:password@127.0.0.1:3306/gameku_store
# Required before a transfer: path to a verified mysqldump/pg_dump and its SHA-256.
LEGACY_BACKUP_FILE=
LEGACY_BACKUP_SHA256=
LEGACY_TIMEZONE=Asia/Bangkok
LEGACY_SECURITY_LOG_DIR=./logs

# Optional chat provider. Endpoint must be HTTPS; leave empty to disable chat safely.
GAMEKU_CHAT_ENDPOINT=
GAMEKU_CHAT_API_KEY=
GAMEKU_CHAT_MODEL=gpt-4o-mini
