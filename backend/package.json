{
  "name": "gameku-store-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node node_modules/prisma/build/index.js generate",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:transfer:check": "node scripts/transfer-data.js --check",
    "db:transfer": "node scripts/transfer-data.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "dotenv": "^16.6.1",
    "mysql2": "^3.15.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
